APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alexios-hermes-control-plane
MAX_CONCURRENT_ACTIVITIES=6
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hermes_control_plane

# Portfolio site registry as JSON. Built-in defaults cover the 9 canonical portfolio sites.
PORTFOLIO_SITES_JSON=

# First-party GSC evidence. On Docker/VPS, mount the service-account JSON read-only and point
# this to the in-container path. Leave blank to keep GSC disabled and force NEEDS_DATA.
GSC_SERVICE_ACCOUNT_FILE=
GSC_DAYS=28
GSC_DATA_LAG_DAYS=3
GSC_ROW_LIMIT=5000
GSC_REQUEST_TIMEOUT_SECONDS=30

# Telegram: one main UI bot. In production, set both webhook secret and allowed user IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=

# OpenAI: native Responses API + Pydantic Structured Outputs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_LUNA_REASONING=low
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_TERRA_REASONING=high
OPENAI_SOL_MODEL=gpt-5.6-sol
OPENAI_SOL_REASONING=xhigh

# GLM endpoints may be native or an OpenAI-compatible provider/gateway.
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=glm-5.3
GLM_FLASH_API_KEY=
GLM_FLASH_BASE_URL=
GLM_FLASH_MODEL=glm-5.3-flash

# DeepSeek V4 Flash: implementation engine, still reserved from read-only runs.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING=high

# Hard safety gate. Keep false until approval/rollback/write-lock workflows are complete.
ALLOW_PRODUCTION_WRITES=false

APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alexios-hermes-control-plane
MAX_CONCURRENT_ACTIVITIES=6
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hermes_control_plane

# Portfolio site registry as JSON. Defaults to the built-in canonical 9-site registry when unset.
PORTFOLIO_SITES_JSON=

# Google Search Console read-only evidence ingestion.
GSC_SERVICE_ACCOUNT_HOST_FILE=./secrets/gsc-service-account.json
GSC_SERVICE_ACCOUNT_FILE=/run/secrets/gsc-service-account.json
GSC_LOOKBACK_DAYS=28
GSC_ROW_LIMIT=250
GSC_MAX_SITES_PER_RUN=12

# Telegram UI and autonomous-cycle summaries.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
AUTONOMOUS_NOTIFICATION_CHAT_ID=

# OpenAI model routes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_LUNA_REASONING=low
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_TERRA_REASONING=high
OPENAI_SOL_MODEL=gpt-5.6-sol
OPENAI_SOL_REASONING=xhigh

# GLM model routes.
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=glm-5.3
GLM_FLASH_API_KEY=
GLM_FLASH_BASE_URL=
GLM_FLASH_MODEL=glm-5.3-flash

# Implementer model route.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING=high

# Autonomous growth loop. Start in DRAFT. STAGING/PRODUCTION_APPROVED require WordPress credentials.
AUTONOMOUS_GROWTH_ENABLED=false
AUTONOMOUS_GROWTH_INTERVAL_HOURS=24
AUTONOMOUS_GROWTH_MODE=DRAFT
AUTONOMOUS_GROWTH_OBJECTIVE=Improve existing portfolio URLs for organic traffic, SEO, GEO, AEO, AI visibility, SERP performance, topical authority, user value, and monetization using verified evidence.
AUTONOMOUS_MAX_INTERVENTIONS_PER_CYCLE=3
AUTONOMOUS_MAX_MUTATIONS_PER_SITE=1

# WordPress registry JSON. Use one restricted service user + Application Password per site.
# public_url is the canonical public hostname used to resolve intervention URLs.
# base_url may point to staging while AUTONOMOUS_GROWTH_MODE=STAGING.
# Example shape only; never commit real credentials:
# [{"site_id":"example.com","public_url":"https://example.com","base_url":"https://staging.example.com","username":"hermes-bot","application_password":"..."}]
WORDPRESS_SITES_JSON=
WORDPRESS_REQUEST_TIMEOUT_SECONDS=30
WORDPRESS_ALLOW_CONTENT_UPDATES=true
WORDPRESS_ALLOW_TITLE_UPDATES=true
WORDPRESS_ALLOW_STATUS_CHANGES=false
WORDPRESS_BACKUP_DIR=/var/lib/ahcp/backups

# Hard final production gate. Keep false until staging acceptance passes.
ALLOW_PRODUCTION_WRITES=false
